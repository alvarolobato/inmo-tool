# =============================================================================
# inmo-tool — environment variables
# Copy this file to .env and fill in your values.
#   cp .env.example .env
# .env is git-ignored; never commit real credentials.
#
# Configuration precedence (highest → lowest):
#   1. Environment variables (these, or set in the shell before docker compose)
#   2. ~/.config/inmo-tool/config.yaml  (created automatically on first
#      start from current env + defaults; editable via /admin/config)
#   3. Hardcoded defaults (see config/schema.yaml for all keys and defaults)
#
# Removing a variable from this file will cause the value in config.yaml
# (if present) to take over. This lets you migrate settings from env vars to
# the central YAML file one by one.
#
# Status: this is a minimal skeleton after task 1.1 (#9) stripped the
# PowerShop/4D/WrenAI-specific variables that used to live here. Connector
# source credentials (task 1.4/2.1, #12/#15) and any LLM/agentic-tool
# variables Phase 4 needs get added here as those tasks land — don't
# pre-guess their shape now.
# =============================================================================

# -----------------------------------------------------------------------------
# Release channel (production / docker-compose.prod.yml only)
# -----------------------------------------------------------------------------
# No images have been published for this project yet (no release cut) — these
# are inert until that happens. See docs/skills/skills.md once a release skill
# is written for this repo.
ETL_VERSION=latest
DASHBOARD_VERSION=latest
# Override if you publish to a different Docker Hub namespace.
# DOCKERHUB_NAMESPACE=your_dockerhub_namespace

# Override the host directory that is mounted as /config inside the ETL and
# Dashboard containers. Defaults to ~/.config/inmo-tool.
# INMO_TOOL_CONFIG_DIR=/home/myuser/.config/inmo-tool

# Interface to bind host ports on. 0.0.0.0 = reachable on every network
# interface (LAN). 127.0.0.1 = loopback only (useful behind a reverse proxy).
HOST_BIND=0.0.0.0

# -----------------------------------------------------------------------------
# PostgreSQL (local mirror — destination for connector sync)
# -----------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=inmotool
# POSTGRES_HOST and POSTGRES_PORT default to "localhost" and "5432" when unset.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# POSTGRES_DSN overrides the split variables above (use for explicit control).
# Example: POSTGRES_DSN=postgresql://postgres:password@localhost:5432/inmotool
POSTGRES_DSN=

# -----------------------------------------------------------------------------
# Dashboard LLM (via OpenRouter — https://openrouter.ai)
# -----------------------------------------------------------------------------
# Kept because the Dashboard App's LLM plumbing (dashboard/lib/llm-context/,
# dashboard/lib/llm-tools/) is reused as-is per issue #1 §14 — see
# docs/skills/llm-context.md for what's inherited vs. rebuilt in Phase 4.
OPENROUTER_API_KEY=your_openrouter_api_key

# No connector-schedule variable: the orchestrator (etl/orchestrator.py
# run_scheduler_loop, task 1.3) runs every registered connector immediately
# on startup, then hourly — not independently configurable per-connector
# yet. An ETL_CRON_HOUR var existed here through task 1.5 but was never
# read by any code (dead since task 1.1); removed in task 1.6 (#14).

# -----------------------------------------------------------------------------
# Cimenta2 connector detail-fetch (issue #136, D-035)
# -----------------------------------------------------------------------------
# Endpoint the connector fetches per-property detail from. Leave BLANK and the
# connector stays discovery-only (sitemap sweep, no detail request) — the
# public-safe default. Set it (locally / via a secret, never committed) to
# enable detail-fetch. The real value is intentionally absent from this repo.
CIMENTA2_DETAIL_ENDPOINT=
# true = also store bank-internal commercial fields (acquisition cost,
# appraisal) in listing.raw_extra. Default false. Owner-contact fields are
# never stored either way.
CIMENTA2_INCLUDE_INTERNAL=

# -----------------------------------------------------------------------------
# Dashboard App (AI-generated dashboards — UI content pending Phase 2 rework)
# -----------------------------------------------------------------------------
# Port exposed to host for Dashboard App (default: 4000)
DASHBOARD_PORT=4000

# Optional: git describe string baked into the dashboard image footer for non-release builds.
# `ps stack` sets this from the repo when you build via compose; override for CI or plain `docker compose build`.
# APP_GIT_DESCRIBE=v0.1.0-3-gabc1234

# Dashboard LLM transport: openrouter (HTTP API) or cli (local agent, default driver: Claude Code).
# Value must be exactly "openrouter" or "cli" (case-insensitive); other strings are rejected at startup.
# DASHBOARD_LLM_PROVIDER=openrouter

# Models per backend. Manage from the admin UI (/admin/config) — env vars
# override config.yaml and force the field read-only, so leave these
# commented unless you genuinely want a hard pin.
# DASHBOARD_LLM_MODEL_OPENROUTER=anthropic/claude-sonnet-4
# DASHBOARD_LLM_MODEL_CLI=claude-sonnet-4-6

# CLI driver and process tuning (only when DASHBOARD_LLM_PROVIDER=cli)
# DASHBOARD_LLM_CLI_DRIVER=claude_code
# DASHBOARD_LLM_CLI_BIN=claude
# Space-separated extra argv tokens after the binary (no shell interpolation)
# DASHBOARD_LLM_CLI_EXTRA_ARGS=
# DASHBOARD_LLM_CLI_TIMEOUT_MS=120000
# DASHBOARD_LLM_CLI_MAX_CAPTURE_BYTES=8000000

# Claude Code CLI credentials for DASHBOARD_LLM_PROVIDER=cli.
# Run once: claude /install-github-app
# Then copy the full contents of ~/.claude/.credentials.json here (single line, JSON).
# Valid for 1 year. Regenerate annually or after re-running /install-github-app.
# DO NOT refresh from inside the container — see docs/decisions/archive/D-025-oauth-single-refresher.md;
# re-establish this as a fresh decision if/when the CLI provider is actually used (Phase 4).
# CLAUDE_CODE_OAUTH_TOKEN={"claudeAiOauth":{"accessToken":"sk-ant-oat01-...","refreshToken":"sk-ant-ort01-...","expiresAt":1234567890000}}

# Shared secret for /api/admin/* (x-admin-key or Authorization: Bearer) and /admin/* UI cookie login.
# Also used by /api/profiles/materialize-all and by the ETL container, which
# authenticates its post-run materialize callback with it (issue #94) — set it
# on both services or newly ingested listings stay unscored (the call 401s).
# Use a long random string in production.
# ADMIN_API_KEY=

# Dashboard base URL as seen from the ETL container (issue #94). After each
# connector run the orchestrator POSTs {base}/api/profiles/materialize-all so
# fresh listings are materialized into profiles and scored automatically.
# Defaults to compose's internal service DNS. Set to "" to disable the call.
# ETL_DASHBOARD_BASE_URL=http://dashboard:4000
# Timeout (seconds) for that callback; on timeout the run still succeeds.
# ETL_DASHBOARD_CALLBACK_TIMEOUT_SECONDS=30

# Set ADMIN_COOKIE_SECURE=true only when the dashboard is served over HTTPS (e.g. behind TLS).
# On plain HTTP (typical LAN access by IP), leave unset so the browser stores the admin session cookie.
# ADMIN_COOKIE_SECURE=true

# Public URL — set when running behind a reverse proxy / custom domain.
# The dashboard uses APP_PUBLIC_URL for self-referencing API calls.
# APP_PUBLIC_URL=https://dashboard.example.com

# Optional daily spend cap for LLM calls in USD (e.g. 5.00); unset = no limit
# LLM_DAILY_BUDGET_USD=5.00

# Optional: reject dashboard /api/query requests when EXPLAIN total cost exceeds
# this positive integer. Unset or zero = no cost-based rejection (recommended for local use).
# QUERY_COST_LIMIT=500000

# Agentic tool-calling for generate/modify/analyze (defaults match production policy)
# DASHBOARD_AGENTIC_TOOLS_ENABLED=true
# DASHBOARD_AGENTIC_MAX_TOOL_ROUNDS=8
# DASHBOARD_AGENTIC_MAX_TOOL_CALLS=24
# DASHBOARD_AGENTIC_TOOL_TIMEOUT_MS=15000
# DASHBOARD_AGENTIC_MAX_ROWS=200
# DASHBOARD_AGENTIC_MAX_COLUMNS=30
# DASHBOARD_AGENTIC_MAX_RESULT_CHARS=20000

# Automatic AI-assessment pass (#308): the dashboard runs occupancy/condition/
# redflags/extract for ingested properties lacking a current verdict, so the
# candidate feed shows the badges. Bounded + idempotent + budget-safe.
# DASHBOARD_ASSESSMENT_AUTO_ENABLED=true
# DASHBOARD_ASSESSMENT_BATCH_SIZE=5
# DASHBOARD_ASSESSMENT_INTERVAL_SECONDS=900

# -----------------------------------------------------------------------------
# OpenTelemetry + Elastic Observability
# Set ELASTIC_OTLP_* in production; leave commented in local dev.
# Collector runs in both modes — locally it writes to ./otel/local/local.jsonl.
# -----------------------------------------------------------------------------

# Elastic Cloud OTLP ingest endpoint (Observability → APM → Set up Agents).
# When set, the OTel collector ships all traces/metrics/logs to Elastic Cloud.
# Leave commented in local dev to use the file sink (./otel/local/) instead.
# ELASTIC_OTLP_ENDPOINT=https://<deployment>.ingest.<region>.cloud.es.io:443

# API key for Elastic Cloud OTLP ingest (create in Elastic Cloud > API Keys).
# ELASTIC_OTLP_API_KEY=<base64 key>

# Elastic RUM server URL (used by @elastic/apm-rum in the browser).
# ELASTIC_RUM_SERVER_URL=https://<deployment>.apm.<region>.cloud.es.io
# ELASTIC_RUM_SERVICE_NAME=inmo-tool-dashboard-rum

# Deployment environment label stamped on every span/metric/log record.
# Defaults to "development" locally.
# ENVIRONMENT=production

# Internal OTel SDK configuration — consumed by ETL and Dashboard containers.
# Change only if you swap out the collector or adjust the sampling strategy.
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_TRACES_SAMPLER=parentbased_always_on
OTEL_LOG_LEVEL=info

# -----------------------------------------------------------------------------
# Docker Hub (used by GitHub Actions to push images, once a release exists)
# -----------------------------------------------------------------------------
DOCKERHUB_USERNAME=your_dockerhub_username
DOCKERHUB_TOKEN=your_dockerhub_access_token
