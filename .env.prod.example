# Production .env template. Copied to the deployment directory on the host as
# .env, mode 0600, and NEVER committed. `deploy/install-prod.sh` generates it;
# this file is the reference for what each value means.
#
# This is NOT .env.example (the local-development one). There, the stack runs
# its own PostgreSQL; here it connects to a cluster that already exists on the
# host and is shared with other applications.
#
# Everything host-specific — network name, database host, ports, hostnames —
# lives in this file on the host, not in the repository. inmo-tool is public.

# --- Shared PostgreSQL ---------------------------------------------------
# Docker network the cluster is on, and the name it answers to inside it.
# Both are properties of the host's own setup; there is no sensible default.
SHARED_NETWORK=
POSTGRES_HOST=
POSTGRES_PORT=5432

# Cluster ADMIN credentials. Used only at startup, by deploy/db-init.sh, to
# create the role and the database. They never reach the etl or dashboard
# containers.
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=
POSTGRES_ADMIN_MAINTENANCE_DB=postgres

# --- inmo-tool's own role ------------------------------------------------
# Created by db-init without SUPERUSER or CREATEDB: it shares a cluster with
# other applications' data. Generate the password with:
#   openssl rand -hex 20
POSTGRES_USER=inmotool
POSTGRES_PASSWORD=
POSTGRES_DB=inmotool

# --- Dashboard -----------------------------------------------------------
# Host port. Pick one that is free on the host — see config/production.md.
DASHBOARD_PORT=
# 0.0.0.0 makes the dashboard reachable from the LAN, which is what a reverse
# proxy or tunnel on the host needs in order to reach the origin.
HOST_BIND=0.0.0.0

# Shared secret for the admin cookie and for machine callers (the ETL's
# post-run scoring callback authenticates with it). REQUIRED in production —
# the compose file refuses to start without it. Generate with:
#   openssl rand -hex 32
ADMIN_API_KEY=

# true whenever the dashboard is served over HTTPS, which it is as soon as
# anything terminates TLS in front of it. Leaving it false there would emit a
# session cookie without the Secure flag.
ADMIN_COOKIE_SECURE=true

# --- LLM -----------------------------------------------------------------
# One of the two, depending on config.yaml's dashboard.llm_provider:
OPENROUTER_API_KEY=
# For provider=cli: the full contents of ~/.claude/.credentials.json, quoted.
CLAUDE_CODE_OAUTH_TOKEN=

# --- Telemetry (optional) ------------------------------------------------
# Without these the collector writes JSONL under ./otel/local/ instead.
ELASTIC_OTLP_ENDPOINT=
ELASTIC_API_KEY=
ENVIRONMENT=production
