# Python
.venv
# …and any suffixed variant. `.venv` alone does NOT match `.venv312`, which is
# how a 3,566-file virtualenv (numpy, scipy, grpc roots.pem, pip vendored idna)
# got committed onto this very branch and left the PR unreviewable for 8 days.
.venv*
venv/
__pycache__/
*.pyc
*.pyo
*.egg-info/
dist/
build/

# Local credentials (never commit)
local/

# Environment files (contain secrets — .env.example and .env.prod.example are
# committed, the real ones are not). .env.bak.* is what install-prod.sh leaves
# behind on the deployment host, which is a checkout of this repo.
.env
.env.local
.env.bak.*

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Generated reports and sample data (contain real business data)
docs/reports/*.html
docs/reports/*.json
docs/sample-data/

# Persistent bind-mount data (Docker volumes — never commit)
data

# Dashboard App
dashboard/node_modules
dashboard/.next/
dashboard/tsconfig.tsbuildinfo

# Coverage
.coverage
coverage.xml
htmlcov/

# Runtime/temp
*.log
tmp/
_*.py
!__init__.py
_*.json

# Vitest coverage output
dashboard/coverage/
otel/local/*.jsonl
otel/local/*.json

# Playwright e2e output (local runs; CI uploads these as workflow artifacts)
dashboard/test-results/
dashboard/playwright-report/

# Generated at build time by scripts/build-extension-zip.sh (staged into the
# dashboard build context so the image can serve the extension). Never committed.
dashboard/public/inmo-tool-extension.zip
dashboard/public/extension-version.json
node_modules
