{
  "manifest_version": 3,
  "name": "Inmo-Tool Listing Capture",
  "version": "0.16.0",
  "description": "Capture a rendered listing page into inmo-tool, for sites the automated connectors can't reach (Idealista, Aliseda, Altamira, Hipoges).",
  "permissions": ["activeTab", "alarms", "notifications", "scripting", "storage", "tabs"],
  "host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*",
    "*://*.idealista.com/*",
    "*://*.alisedainmobiliaria.com/*",
    "*://*.altamirainmuebles.com/*",
    "*://realestate.hipoges.com/*"
  ],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.idealista.com/*",
        "*://*.alisedainmobiliaria.com/*",
        "*://*.altamirainmuebles.com/*",
        "*://realestate.hipoges.com/*"
      ],
      "js": ["detect.js", "diagnostic.js", "discover.js", "observe-search-url.js", "content-script.js"],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options.html",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
